{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:vercel": "vercel dev --listen 3000",
    "dev:local": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src api",
    "smoke-test": "node scripts/smoke-test.mjs",
    "smoke-test:admin": "node scripts/admin-smoke-test.mjs",
    "seed:admin": "tsx --env-file=.env.local scripts/seed-admin.ts"
  },
  "dependencies": {
    "@vercel/blob": "^0.27.3",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.13.3",
    "oxlint": "^1.81.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vercel": "^48.5.2"
  }
}
