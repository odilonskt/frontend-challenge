# Vercel Blob read/write token for this project's Blob store
# (vercel blob store add, or the Vercel dashboard -> Storage -> Blob)
BLOB_READ_WRITE_TOKEN=

# Secret used to sign/verify JWTs issued by POST /auth/token.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=

# Optional: port used by `pnpm dev:local` (plain Express listener, not `vercel dev`).
# Must not be 4000 — that's server/ (006) and apps/web's coins client default.
PORT=4001
